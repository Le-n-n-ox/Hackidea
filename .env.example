# ---- LLM provider (OpenAI-compatible: OpenAI, OpenRouter, Nous, hermes proxy, Ollama, ...) ----
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=300
LLM_MAX_RETRIES=3
LLM_MAX_TOKENS=8000

# NVIDIA API option (use your NVIDIA API key and model credits):
#   LLM_PROVIDER=openai_compat
#   LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#   LLM_API_KEY=nvapi-your-key-here
#   LLM_MODEL=nvidia/nemotron-3.5-bolt-e4b

# Free local option (no API key): run `hermes proxy start` (Hermes Agent, OAuth-backed),
# then use:
#   LLM_BASE_URL=http://127.0.0.1:8645/v1
#   LLM_API_KEY=local-proxy
#   LLM_MODEL=qwen/qwen4-max:free

# ---- Search provider ----
# ddgs = free, no key (DuckDuckGo-family meta-search; backends tried in order)
# tavily / brave = keyed alternatives
# all = every provider that has a key below, plus ddgs; results are fused.
# A comma-separated list (e.g. tavily,brave) picks specific ones.
SEARCH_PROVIDER=ddgs
DDGS_BACKENDS=google,duckduckgo,bing,mojeek
SEARCH_TIMEOUT=30
TAVILY_API_KEY=
BRAVE_API_KEY=

# ---- Pipeline ----
DEPTH=standard            # quick | standard | deep
RUNS_DIR=runs
CACHE_DIR=.cache
FETCH_TIMEOUT=25
MAX_FETCH_WORKERS=4

# ---- Telegram (optional chat interface) ----
# Create a bot with @BotFather, then paste its token here.
TELEGRAM_BOT_TOKEN=
# Add your numeric Telegram user ID after sending /id to your bot.
# Multiple IDs can be comma-separated. Without an allowlist, pipeline runs are disabled.
TELEGRAM_ALLOWED_USER_IDS=
