# ---- LLM provider (OpenAI-compatible: OpenAI, OpenRouter, Nous, hermes proxy, Ollama, ...) ----
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=300
LLM_MAX_RETRIES=3
LLM_MAX_TOKENS=8000

# Free local option (no API key): run `hermes proxy start` (Hermes Agent, OAuth-backed),
# then use:
#   LLM_BASE_URL=http://127.0.0.1:8645/v1
#   LLM_API_KEY=local-proxy
#   LLM_MODEL=qwen/qwen4-max:free

# ---- Search provider ----
# ddgs = free, no key (DuckDuckGo-family meta-search; backends tried in order)
# tavily / brave = keyed alternatives
# all = every provider that has a key below, plus ddgs; results are fused.
# A comma-separated list (e.g. tavily,brave) picks specific ones.
SEARCH_PROVIDER=ddgs
DDGS_BACKENDS=google,duckduckgo,bing,mojeek
SEARCH_TIMEOUT=30
TAVILY_API_KEY=
BRAVE_API_KEY=

# ---- Pipeline ----
DEPTH=standard            # quick | standard | deep
RUNS_DIR=runs
CACHE_DIR=.cache
FETCH_TIMEOUT=25
MAX_FETCH_WORKERS=4